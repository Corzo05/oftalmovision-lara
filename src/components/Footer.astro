---
import { Image } from 'astro:assets';
import LogoSvg from '../assets/images/OftalmovisionLaraSvg.svg';
import { Icon } from 'astro-icon/components';

const actualYear: number = new Date().getFullYear();
---

<footer class="flex flex-col text-bright m-0 border-t-2 border-sky-300 bg-blue-custom">
    <div class="flex flex-col md:flex-row flex-wrap justify-between gap-10 px-6 lg:px-12 py-16 max-w-7xl mx-auto w-full">
        
        <div class="flex flex-col items-center md:items-start text-center md:text-left max-w-xs mx-auto md:mx-0">
            <div class="flex flex-row items-center mb-4">
                <Image src={LogoSvg} alt="Logo" width={80} class="mr-3 text-custom-glow" />
                <h4 class="text-xl tracking-wide font-inter font-extralight border-b-2 border-sky-300 pb-1">Oftalmovisión Lara</h4>
            </div>
            <p class="font-mont text-sm text-bright/80 mb-3">Cuidamos tu visión para que sigas disfrutando cada momento.</p>
            <span class="font-mont text-xs text-bright/60">Consulta · Diagnóstico · Tratamiento · Salud visual</span>
        </div>

        <div class="flex flex-col items-center md:items-start">
            <h4 class="text-xl font-inter font-extralight border-b-2 border-sky-300 w-fit mb-4">Secciones</h4>
            <div class="flex flex-col font-mont text-sm gap-2">
                <div class="flex flex-row items-center group">
                    <Icon name="lucide:arrow-right" class="w-6 h-6 text-sky-300 transition-transform group-hover:translate-x-1" />
                    <a href="#" class="ml-2 hover:text-sky-300 transition-colors">Home</a>
                </div>
                <div class="flex flex-row items-center group">
                    <Icon name="lucide:arrow-right" class="w-6 h-6 text-sky-300 transition-transform group-hover:translate-x-1" />
                    <a href="#nosotros" class="ml-2 hover:text-sky-300 transition-colors">Quiénes Somos</a>
                </div>
                <div class="flex flex-row items-center group">
                    <Icon name="lucide:arrow-right" class="w-6 h-6 text-sky-300 transition-transform group-hover:translate-x-1" />
                    <a href="#servicios" class="ml-2 hover:text-sky-300 transition-colors">Servicios</a>
                </div>
                <div class="flex flex-row items-center group">
                    <Icon name="lucide:arrow-right" class="w-6 h-6 text-sky-300 transition-transform group-hover:translate-x-1" />
                    <a href="#contacto" class="ml-2 hover:text-sky-300 transition-colors">Contáctanos</a>
                </div>
            </div>
        </div>

        <div class="flex flex-col items-center md:items-start">
            <h4 class="text-xl font-inter font-extralight border-b-2 border-sky-300 w-fit mb-4">Horario</h4>
            <div class="flex flex-col font-mont text-sm gap-3">
                <div class="flex flex-row items-center">
                    <Icon name="lucide:clock" class="w-7 h-7 text-sky-300 shrink-0" />
                    <div class="flex flex-col ml-3">
                        <span class="font-medium">Lunes a viernes</span>
                        <span class="text-bright/80">2:00 PM - 5:00 PM</span>
                    </div>
                </div>
                <div class="flex flex-row items-center">
                    <Icon name="lucide:clock" class="w-7 h-7 text-sky-300 shrink-0" />
                    <div class="flex flex-col ml-3">
                        <span class="font-medium">Sábado</span>
                        <span class="text-bright/80">8:00 AM - 2:00 PM</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col items-center md:items-start max-w-xs mx-auto md:mx-0">
            <h4 class="text-xl font-inter font-extralight border-b-2 border-sky-300 w-fit mb-4">Contáctanos</h4>
            <div class="flex flex-col font-mont text-sm gap-3">
                <div class="flex flex-row items-center group">
                    <Icon name="lucide:map-pin-search" class="w-7 h-7 text-sky-300 shrink-0" />
                    <a href="https://www.google.com/maps/place/3MCW%2B6WC+Policlinica+Catedral,+Barquisimeto+3001,+Lara/data=!4m2!3m1!1s0x8e876776d7b2c6e5:0x36a376565bb23147!18m1!1e1?utm_source=mstt_1&entry=gps&coh=192189&g_ep=CAESBzI2LjM1LjMYACCenQoqswEsMTAwODM0MjMwLDk0MjY3NzI3LDk0MjkyMTk1LDk0Mjk5NTMyLDEwMDc5NjQ5OCwxMDA3OTc3NjEsMTAwNzk2NTM1LDk0MjgwNTc2LDk0MjA3Mzk0LDk0MjA3NTA2LDk0MjA4NTA2LDk0MjE4NjUzLDk0MjI5ODM5LDk0Mjc1MTY4LDk0Mjc5NjE5LDEwMDgxNTY0MCwxMDA4MjUwMjUsMTAwODIwMjM3LDEwMDgyMjQ5NEICVkU%3D&skid=1b9a9856-c9b0-48ea-9e2a-4accceb8e563" rel="noreferrer" target="_blank" class="ml-3 wrap-break-word max-w-xs hover:text-sky-300 transition-colors">Carrera 22 con calle 11, Policlínica Catedral. Barquisimeto, Lara</a>
                </div>
                <div class="flex flex-row items-center group">
                    <Icon name="lucide:phone" class="w-7 h-7 text-sky-300 shrink-0" />
                    <a href="tel:+584225533255" rel="noreferrer" target="_blank" class="ml-3 hover:text-sky-300 transition-colors">0422-5533255</a>
                </div>
                <div class="flex flex-row items-center group">
                    <Icon name="simple-icons:whatsapp" class="w-7 h-7 text-sky-300 shrink-0" />
                    <a href="https://wa.me/+584143550490" rel="noreferrer" target="_blank" class="ml-3 hover:text-sky-300 transition-colors">+58414-3550490</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="flex justify-center items-center py-2 bg-[color-mix(in_srgb,var(--blue-custom)_85%,black)] font-inter font-light text-xs md:text-sm text-bright/60">
        <span>Desarrollado por Corzzzito © {actualYear}</span>
    </div>
</footer>
---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="flex flex-col justify-between h-full p-6 bg-[color-mix(in_srgb,var(--blue-custom)_85%,black)] border border-skyblue-custom/30 hover:border-skyblue-custom transition-all duration-300 group rounded-none">
    <div>
        <div class="w-8 border-t-2 border-skyblue-custom mb-4 group-hover:w-full transition-all duration-500"></div>
        <h3 class="text-xl font-inter font-medium text-dark mb-2 group-hover:text-skyblue-custom transition-colors">{title}</h3>
        <p class="font-mont text-sm text-dark leading-relaxed">{description}</p>
    </div>
    <a href="#form-consult-div" class="anchor-service mt-6 pt-4 border-t border-bright/10 flex items-center justify-between">
        <span class="transition-all duration-500 text-xs uppercase tracking-wider text-skyblue-custom font-inter group-hover:bg-skyblue-custom group-hover:text-bright py-2 px-4">Agendar Cita</span>
        <span class="text-skyblue-custom transform group-hover:translate-x-1 transition-transform">→</span>
    </a>
</div>